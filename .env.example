# Yerel geliştirme örneği. Bu dosyadaki TÜM değerler sahtedir; kopyalayıp `.env` olarak kullanın.
# `.env` git tarafından yok sayılır. Gerçek secret'ı bu dosyaya yazmayın.

# --- docker-compose.yml (yalnızca yerel PostgreSQL 18) ---
POSTGRES_USER=sokagimdakisorun
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sokagimdakisorun
POSTGRES_HOST_PORT=54318

# --- API (ASP.NET Core; bölüm ayırıcı __) ---
# Host makinede çalışan API, konteynerdeki PostgreSQL'e POSTGRES_HOST_PORT üzerinden bağlanır.
ConnectionStrings__Default=Host=localhost;Port=54318;Database=sokagimdakisorun;Username=sokagimdakisorun;Password=change-me-local-only
# Açılışta tüm modül migration'larını uygula. Yalnızca yerel geliştirme; varsayılan false (WS-03).
Database__ApplyMigrationsOnStartup=true
# Outbox dağıtıcısı (isteğe bağlı; aşağıdakiler varsayılan değerlerdir, tanımlamak gerekmez).
# Outbox__Enabled=true
# Outbox__PollingInterval=00:00:02
# Outbox__BatchSize=20
# Outbox__MaxAttempts=8
# Outbox__BaseRetryDelay=00:00:05
# Outbox__MaxRetryDelay=00:15:00

# --- Identity (WS-04) ---
# İlk Admin hesabı: ikisi de tanımlıysa ve bu e-postayla kullanıcı yoksa açılışta oluşturulur; varsa hiçbir şey değişmez.
# Parola en az 12 karakter, büyük/küçük harf, rakam ve sembol içermelidir. Gerçek değer yalnızca ortam değişkeninde/secret store'da.
Seed__AdminEmail=admin@example.test
Seed__AdminPassword=Change-Me-Local-Only-1!

# --- Media (WS-05) ---
# Medya kök dizini (zorunlu). Yerelde git dışı ./.local/media; Railway'de Volume'un bağlandığı yol (WS-11).
Media__RootPath=./.local/media
# İsteğe bağlı; aşağıdakiler varsayılan değerlerdir.
# Media__MaxFileSizeBytes=10485760
# Media__TemporaryRetention=2.00:00:00
# Media__OrphanFileGracePeriod=01:00:00
# Media__CleanupInterval=00:15:00
# Media__CleanupBatchSize=100
# Media__CleanupEnabled=true

# --- Complaints (WS-06) ---
# Gelibolu / Yazıcızade için tamamen temsili demo verisi (kategori, birim, örnek şikâyet). Yalnızca Development ortamında etkili;
# varsayılan false. Gerçek kurum/kişi verisi içermez (docs/PROJECT_BRIEF.md §10).
Complaints__DemoSeed__Enabled=true
