# Yerel geliştirme örneği. Bu dosyadaki TÜM değerler sahtedir; kopyalayıp `.env` olarak kullanın.
# `.env` git tarafından yok sayılır. Gerçek secret'ı bu dosyaya yazmayın.

# --- docker-compose.yml (yalnızca yerel PostgreSQL 18) ---
POSTGRES_USER=sokagimdakisorun
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sokagimdakisorun
POSTGRES_HOST_PORT=54318

# --- API (ASP.NET Core; bölüm ayırıcı __) ---
# Host makinede çalışan API, konteynerdeki PostgreSQL'e POSTGRES_HOST_PORT üzerinden bağlanır.
ConnectionStrings__Default=Host=localhost;Port=54318;Database=sokagimdakisorun;Username=sokagimdakisorun;Password=change-me-local-only
