<Project>

  <!-- Merkezi paket yönetimi: sürümler yalnızca burada durur. Yeni paket PR'da gerekçelendirilir. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Api">
    <!-- .NET 10 yerleşik OpenAPI belge üretimi (paylaşılan çerçevede değil, ayrı paket). -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Yerleşik OpenAPI belgesini build sırasında dosyaya yazan resmî MSBuild entegrasyonu (yalnızca build). -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <!-- xunit.v3, Microsoft.Testing.Platform üzerinde çalışır; .NET 10'da ayrı test SDK'sı/VSTest adaptörü gerekmez. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- WebApplicationFactory ile in-memory host bileşen testleri. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>

</Project>
