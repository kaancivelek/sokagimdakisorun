<Project>

  <!-- Merkezi paket yönetimi: sürümler yalnızca burada durur. Yeni paket PR'da gerekçelendirilir. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Api">
    <!-- .NET 10 yerleşik OpenAPI belge üretimi (paylaşılan çerçevede değil, ayrı paket). -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Yerleşik OpenAPI belgesini build sırasında dosyaya yazan resmî MSBuild entegrasyonu (yalnızca build). -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Platform">
    <!-- PostgreSQL için EF Core sağlayıcısı (ADR-0002). 10.x hattı EF Core 10 ile eşleşir. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- EF Core ilişkisel katmanı: Npgsql'in alt sınırı (10.0.4) yerine diğer Microsoft 10.0.x paketleriyle aynı güncel yama. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <!-- snake_case adlandırma konvansiyonu (V-2): net10.0 hedefler, EF Core [10.0.1, 11.0.0) aralığına bağlıdır. -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- `dotnet ef migrations` tasarım-zamanı desteği (yalnızca build; PrivateAssets=all, çalışma zamanına girmez). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Identity">
    <!-- WS-04 paketleri buraya (paralel iş akışlarında birleştirme çakışmasını önlemek için ayrı grup). -->
  </ItemGroup>

  <ItemGroup Label="Media">
    <!-- WS-05 paketleri buraya (paralel iş akışlarında birleştirme çakışmasını önlemek için ayrı grup). -->
  </ItemGroup>

  <ItemGroup Label="Test">
    <!-- xunit.v3, Microsoft.Testing.Platform üzerinde çalışır; .NET 10'da ayrı test SDK'sı/VSTest adaptörü gerekmez. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- WebApplicationFactory ile in-memory host bileşen testleri. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- Odaklı entegrasyon testleri için gerçek PostgreSQL 18 konteyneri (ARCHITECTURE §12; SQLite/in-memory taklidi yok). -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>

</Project>
